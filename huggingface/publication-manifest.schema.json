{
  "$defs": {
    "authorized_benchmark": {
      "additionalProperties": false,
      "properties": {
        "benchmark_id": {"minLength": 1, "type": "string"},
        "benchmark_version": {"minLength": 1, "type": "string"},
        "targets": {"items": {"enum": ["hugging_face_raw", "hugging_face_viewer"]}, "minItems": 1, "type": "array", "uniqueItems": true}
      },
      "required": ["benchmark_id", "benchmark_version", "targets"],
      "type": "object"
    },
    "card_config": {
      "additionalProperties": false,
      "properties": {
        "config_name": {"minLength": 1, "type": "string"},
        "data_files": {"items": {"$ref": "#/$defs/data_file"}, "minItems": 1, "type": "array"},
        "default": {"type": "boolean"},
        "default_explicit": {"type": "boolean"}
      },
      "required": ["config_name", "data_files", "default", "default_explicit"],
      "type": "object"
    },
    "card_operation": {
      "additionalProperties": false,
      "properties": {
        "content_type": {"const": "text/markdown; charset=utf-8"},
        "destination_path": {"const": "README.md"},
        "remote_precondition": {"$ref": "#/$defs/remote_precondition"},
        "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "size_bytes": {"minimum": 1, "type": "integer"},
        "source_path": {"const": "huggingface/README.md"}
      },
      "required": ["content_type", "destination_path", "remote_precondition", "sha256", "size_bytes", "source_path"],
      "type": "object"
    },
    "data_file": {
      "additionalProperties": false,
      "properties": {
        "path": {"minLength": 1, "type": "string"},
        "split": {"minLength": 1, "type": "string"}
      },
      "required": ["path", "split"],
      "type": "object"
    },
    "external_gate": {
      "additionalProperties": false,
      "properties": {
        "evidence_required": {"minLength": 1, "type": "string"},
        "id": {"enum": ["github_environment_protection", "hf_repository_control", "post_upload_integrity", "viewer_remote_validation"]},
        "status": {"const": "pending"}
      },
      "required": ["evidence_required", "id", "status"],
      "type": "object"
    },
    "operation": {
      "additionalProperties": false,
      "properties": {
        "answer_key_label": {"type": ["string", "null"]},
        "artifact_id": {"minLength": 1, "type": "string"},
        "artifact_kind": {"enum": ["checksum_manifest", "evaluator_truth", "manifest", "public_input"]},
        "benchmark_id": {"minLength": 1, "type": "string"},
        "benchmark_version": {"minLength": 1, "type": "string"},
        "content_type": {"enum": ["application/json", "application/x-ndjson", "text/plain; charset=utf-8"]},
        "destination_path": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$", "type": "string"},
        "remote_precondition": {"$ref": "#/$defs/remote_precondition"},
        "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "sensitivity": {"enum": ["public_input", "public_reference_truth"]},
        "size_bytes": {"minimum": 1, "type": "integer"},
        "source_path": {"minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+", "type": "string"},
        "target": {"enum": ["hugging_face_raw", "hugging_face_viewer"]}
      },
      "required": ["answer_key_label", "artifact_id", "artifact_kind", "benchmark_id", "benchmark_version", "content_type", "destination_path", "remote_precondition", "sha256", "sensitivity", "size_bytes", "source_path", "target"],
      "type": "object"
    },
    "remote_file": {
      "additionalProperties": false,
      "properties": {
        "path": {"minLength": 1, "type": "string"},
        "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "size_bytes": {"minimum": 0, "type": "integer"}
      },
      "required": ["path", "sha256", "size_bytes"],
      "type": "object"
    },
    "remote_precondition": {
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"status": {"const": "absent"}}, "required": ["status"]}, "then": {"properties": {"sha256": {"const": null}}}},
        {"if": {"properties": {"status": {"const": "match"}}, "required": ["status"]}, "then": {"properties": {"sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}}}}
      ],
      "properties": {
        "sha256": {"type": ["string", "null"]},
        "status": {"enum": ["absent", "match"]}
      },
      "required": ["sha256", "status"],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorized_benchmarks": {"items": {"$ref": "#/$defs/authorized_benchmark"}, "type": "array"},
    "dataset_card": {
      "additionalProperties": false,
      "properties": {
        "configs": {"items": {"$ref": "#/$defs/card_config"}, "type": "array"},
        "operation": {"$ref": "#/$defs/card_operation"},
        "status": {"const": "governed_update_pending"}
      },
      "required": ["configs", "operation", "status"],
      "type": "object"
    },
    "dataset_repository": {"pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "type": "string"},
    "external_gates": {
      "allOf": [
        {"contains": {"properties": {"id": {"const": "github_environment_protection"}}, "required": ["id"]}, "maxContains": 1, "minContains": 1},
        {"contains": {"properties": {"id": {"const": "hf_repository_control"}}, "required": ["id"]}, "maxContains": 1, "minContains": 1},
        {"contains": {"properties": {"id": {"const": "post_upload_integrity"}}, "required": ["id"]}, "maxContains": 1, "minContains": 1},
        {"contains": {"properties": {"id": {"const": "viewer_remote_validation"}}, "required": ["id"]}, "maxContains": 1, "minContains": 1}
      ],
      "items": {"$ref": "#/$defs/external_gate"},
      "maxItems": 4,
      "minItems": 4,
      "type": "array",
      "uniqueItems": true
    },
    "operations": {"items": {"$ref": "#/$defs/operation"}, "type": "array"},
    "policy": {
      "additionalProperties": false,
      "properties": {
        "network_access": {"const": false},
        "required_gate_targets": {"items": {"enum": ["hugging_face_raw", "hugging_face_viewer"]}, "minItems": 2, "type": "array", "uniqueItems": true},
        "upload_enabled": {"const": false}
      },
      "required": ["network_access", "required_gate_targets", "upload_enabled"],
      "type": "object"
    },
    "prohibited_benchmark_ids": {"const": ["asteria-agentic-c08-v2", "enterprise-agentic-c08-v2"]},
    "registry": {
      "additionalProperties": false,
      "properties": {
        "path": {"const": "docs/_data/benchmarks.resolved.json"},
        "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["path", "sha256"],
      "type": "object"
    },
    "registry_summary": {
      "additionalProperties": false,
      "properties": {
        "candidate": {"minimum": 0, "type": "integer"},
        "hf_authorized_artifacts": {"minimum": 0, "type": "integer"},
        "published": {"minimum": 0, "type": "integer"},
        "total": {"minimum": 0, "type": "integer"}
      },
      "required": ["candidate", "hf_authorized_artifacts", "published", "total"],
      "type": "object"
    },
    "remote_baseline": {
      "additionalProperties": false,
      "properties": {
        "deletion_policy": {"const": "none"},
        "file_count": {"const": 42},
        "files": {"items": {"$ref": "#/$defs/remote_file"}, "maxItems": 42, "minItems": 42, "type": "array"},
        "hub_commit_sha": {"const": "54a7d1e89f683ade507c3518b3e0c0bfddfbe528"},
        "total_bytes": {"const": 354705}
      },
      "required": ["deletion_policy", "file_count", "files", "hub_commit_sha", "total_bytes"],
      "type": "object"
    },
    "schema_version": {"const": "2.0.0"}
  },
  "required": ["authorized_benchmarks", "dataset_card", "dataset_repository", "external_gates", "operations", "policy", "prohibited_benchmark_ids", "registry", "registry_summary", "remote_baseline", "schema_version"],
  "type": "object"
}
