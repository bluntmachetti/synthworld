{
  "$defs": {
    "AllSelectorV1": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "all",
          "default": "all",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "AllSelectorV1",
      "type": "object"
    },
    "CountSelectorV1": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "exclusiveMinimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "kind": {
          "const": "count",
          "default": "count",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "count"
      ],
      "title": "CountSelectorV1",
      "type": "object"
    },
    "FractionSelectorV1": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "exclusiveMinimum": 0,
          "title": "Denominator",
          "type": "integer"
