        "kind": {
          "const": "fraction",
          "default": "fraction",
          "title": "Kind",
          "type": "string"
        },
        "numerator": {
          "exclusiveMinimum": 0,
          "title": "Numerator",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "FractionSelectorV1",
      "type": "object"
    },
    "GroupTemplateV1": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "organisation_key": {
          "title": "Organisation Key",
          "type": "string"
        },
        "owner_unit_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Unit Key"
        },
        "tenant_key": {
          "title": "Tenant Key",
          "type": "string"
        }
      },
      "required": [
        "key",
        "tenant_key",
        "organisation_key"
      ],
      "title": "GroupTemplateV1",
      "type": "object"
    },
    "OrganisationTemplateV1": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "tenant_key": {
          "title": "Tenant Key",
          "type": "string"
        }
      },
      "required": [
        "key",
        "tenant_key"
      ],
      "title": "OrganisationTemplateV1",
      "type": "object"
    },
    "PopulationTemplateV1": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "exclusiveMinimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "organisation_key": {
          "title": "Organisation Key",
          "type": "string"
        },
        "population_kind": {
          "$ref": "#/$defs/PrincipalKind"
        },
        "tenant_key": {
          "title": "Tenant Key",
          "type": "string"
        },
        "unit_key": {
          "title": "Unit Key",
          "type": "string"
        }
      },
      "required": [
        "key",
        "tenant_key",
        "organisation_key",
        "unit_key",
        "population_kind",
        "count"
      ],
      "title": "PopulationTemplateV1",
      "type": "object"
    },
    "PrincipalKind": {
      "enum": [
        "employee",
        "contractor",
        "supplier",
        "partner",
        "service",
        "workload",
        "agent"
      ],
      "title": "PrincipalKind",
      "type": "string"
    },
    "PrincipalSubjectAccessAtomRuleV1": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "population_key": {
          "title": "Population Key",
          "type": "string"
        },
        "resource_set_key": {
          "title": "Resource Set Key",
          "type": "string"
        },
        "rule_key": {
          "title": "Rule Key",
          "type": "string"
        },
        "selector": {
          "discriminator": {
            "mapping": {
              "all": "#/$defs/AllSelectorV1",
              "count": "#/$defs/CountSelectorV1",
              "fraction": "#/$defs/FractionSelectorV1"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AllSelectorV1"
            },
            {
              "$ref": "#/$defs/CountSelectorV1"
            },
            {
              "$ref": "#/$defs/FractionSelectorV1"
            }
          ],
          "title": "Selector"
        }
      },
      "required": [
        "rule_key",
        "population_key",
        "resource_set_key",
        "action",
        "selector"
      ],
      "title": "PrincipalSubjectAccessAtomRuleV1",
      "type": "object"
    },
    "ResourceSetTemplateV1": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "type": "string"
