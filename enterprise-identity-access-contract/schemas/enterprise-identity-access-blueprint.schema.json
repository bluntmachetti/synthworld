      "type": "string"
    },
    "UnitTemplateV1": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "organisation_key": {
          "title": "Organisation Key",
          "type": "string"
        },
        "parent_unit_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Unit Key"
        },
        "tenant_key": {
          "title": "Tenant Key",
          "type": "string"
        },
        "unit_kind": {
          "$ref": "#/$defs/UnitKind"
