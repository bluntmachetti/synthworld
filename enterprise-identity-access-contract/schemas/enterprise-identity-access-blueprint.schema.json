      "type": "string"
    },
    "organisations": {
      "items": {
        "$ref": "#/$defs/OrganisationTemplateV1"
      },
      "minItems": 1,
      "title": "Organisations",
      "type": "array"
    },
    "populations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PopulationTemplateV1"
      },
      "title": "Populations",
      "type": "array"
    },
    "principal_access_atom_rules": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PrincipalSubjectAccessAtomRuleV1"
      },
      "title": "Principal Access Atom Rules",
      "type": "array"
    },
    "resource_sets": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResourceSetTemplateV1"
      },
      "title": "Resource Sets",
      "type": "array"
    },
    "roles": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RoleTemplateV1"
      },
      "title": "Roles",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tenants": {
      "items": {
        "$ref": "#/$defs/TenantTemplateV1"
      },
      "minItems": 1,
      "title": "Tenants",
      "type": "array"
    },
    "units": {
      "default": [],
      "items": {
        "$ref": "#/$defs/UnitTemplateV1"
      },
      "title": "Units",
      "type": "array"
    }
