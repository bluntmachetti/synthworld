          "minItems": 1,
          "title": "Actions",
          "type": "array"
        },
        "instance_count": {
          "exclusiveMinimum": 0,
          "title": "Instance Count",
          "type": "integer"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "organisation_key": {
          "title": "Organisation Key",
          "type": "string"
        },
        "owner_unit_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
