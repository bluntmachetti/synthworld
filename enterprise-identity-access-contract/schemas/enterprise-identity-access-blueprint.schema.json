          "default": null,
          "title": "Owner Unit Key"
        },
        "target_kind": {
          "$ref": "#/$defs/TargetKind"
        },
        "tenant_key": {
          "title": "Tenant Key",
          "type": "string"
        }
      },
      "required": [
        "key",
        "tenant_key",
        "organisation_key",
        "target_kind",
        "instance_count",
        "actions"
      ],
      "title": "ResourceSetTemplateV1",
      "type": "object"
    },
    "RoleTemplateV1": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "organisation_key": {
          "title": "Organisation Key",
          "type": "string"
        },
        "owner_unit_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Unit Key"
        },
        "tenant_key": {
          "title": "Tenant Key",
          "type": "string"
        }
      },
      "required": [
        "key",
        "tenant_key",
        "organisation_key"
      ],
      "title": "RoleTemplateV1",
      "type": "object"
    },
    "TargetKind": {
      "enum": [
        "application",
        "api",
        "tool",
        "data_store",
        "environment"
      ],
      "title": "TargetKind",
      "type": "string"
    },
    "TenantTemplateV1": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
