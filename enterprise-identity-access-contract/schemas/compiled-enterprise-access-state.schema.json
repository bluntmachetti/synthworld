{
  "$defs": {
    "AuthorizationDecision": {
      "enum": [
        "allow",
        "deny"
      ],
      "title": "AuthorizationDecision",
      "type": "string"
    },
    "AuthorizationEvaluationProfileKind": {
      "enum": [
        "rbac",
        "abac",
        "rebac",
        "rbac_with_abac_guard",
        "rebac_with_abac_guard"
      ],
      "title": "AuthorizationEvaluationProfileKind",
      "type": "string"
    },
    "BindingStatus": {
      "enum": [
        "not_applicable",
        "matches_canonical",
        "missing",
        "mismatch"
      ],
      "title": "BindingStatus",
      "type": "string"
    },
    "CompiledEnterpriseAccessCellV1": {
      "additionalProperties": false,
      "properties": {
        "abac_cell_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Abac Cell Id"
        },
        "actual_mechanism_outcomes": {
          "$ref": "#/$defs/MechanismOutcomeSetV1"
        },
        "binding_status": {
          "$ref": "#/$defs/BindingStatus"
        },
        "cell_id": {
          "title": "Cell Id",
          "type": "string"
        },
        "directory_rbac_cell_id": {
          "title": "Directory Rbac Cell Id",
          "type": "string"
        },
        "effective_decision": {
          "$ref": "#/$defs/AuthorizationDecision"
        },
        "final_decision": {
          "$ref": "#/$defs/AuthorizationDecision"
        },
        "intended_decision": {
          "$ref": "#/$defs/AuthorizationDecision"
        },
        "intended_mechanism_outcomes": {
          "$ref": "#/$defs/MechanismOutcomeSetV1"
        },
        "lifecycle_status": {
          "$ref": "#/$defs/LifecycleStatus"
        },
        "policy_conflict_id": {
          "title": "Policy Conflict Id",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/AuthorizationEvaluationProfileKind"
        },
        "rebac_cell_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rebac Cell Id"
        },
        "reconciliation": {
          "$ref": "#/$defs/ReconciliationOutcome"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "cell_id",
        "profile",
        "actual_mechanism_outcomes",
        "intended_mechanism_outcomes",
        "intended_decision",
        "effective_decision",
        "final_decision",
        "reconciliation",
        "binding_status",
        "lifecycle_status",
        "policy_conflict_id",
        "directory_rbac_cell_id",
        "abac_cell_id",
        "rebac_cell_id"
      ],
      "title": "CompiledEnterpriseAccessCellV1",
      "type": "object"
    },
    "LifecycleStatus": {
      "enum": [
        "not_applicable",
        "active",
        "inactive",
        "not_yet_valid",
        "expired"
      ],
      "title": "LifecycleStatus",
      "type": "string"
    },
    "MechanismOutcome": {
      "description": "Native outcome retained before benchmark default-deny normalization.",
      "enum": [
        "allow",
        "deny",
        "not_applicable",
        "unknown"
      ],
      "title": "MechanismOutcome",
      "type": "string"
    },
    "MechanismOutcomeSetV1": {
      "additionalProperties": false,
      "properties": {
        "abac": {
          "anyOf": [
            {
              "$ref": "#/$defs/MechanismOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rbac": {
          "anyOf": [
            {
              "$ref": "#/$defs/MechanismOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rebac": {
          "anyOf": [
            {
              "$ref": "#/$defs/MechanismOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "title": "MechanismOutcomeSetV1",
      "type": "object"
    },
    "PolicyConflictTruthV1": {
      "additionalProperties": false,
      "properties": {
        "actual_allowing_mechanisms": {
          "items": {
            "type": "string"
          },
          "title": "Actual Allowing Mechanisms",
          "type": "array"
        },
        "actual_conflict": {
          "title": "Actual Conflict",
          "type": "boolean"
        },
        "actual_denying_mechanisms": {
          "items": {
            "type": "string"
          },
          "title": "Actual Denying Mechanisms",
          "type": "array"
        },
        "cell_id": {
          "title": "Cell Id",
          "type": "string"
        },
        "conflict_id": {
          "title": "Conflict Id",
          "type": "string"
        },
        "intended_allowing_mechanisms": {
          "items": {
            "type": "string"
          },
          "title": "Intended Allowing Mechanisms",
          "type": "array"
        },
        "intended_conflict": {
          "title": "Intended Conflict",
          "type": "boolean"
        },
        "intended_denying_mechanisms": {
          "items": {
            "type": "string"
          },
          "title": "Intended Denying Mechanisms",
          "type": "array"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "conflict_id",
        "cell_id",
        "actual_conflict",
        "intended_conflict",
        "actual_allowing_mechanisms",
        "actual_denying_mechanisms",
        "intended_allowing_mechanisms",
        "intended_denying_mechanisms"
      ],
      "title": "PolicyConflictTruthV1",
      "type": "object"
    },
    "ReconciliationOutcome": {
      "enum": [
        "aligned_allow",
        "aligned_deny",
        "excessive",
        "missing"
      ],
      "title": "ReconciliationOutcome",
      "type": "string"
    },
    "SyntheticDigestV1": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "SyntheticDigestV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "abac_truth_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/SyntheticDigestV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "authorization_kernel_digest": {
      "$ref": "#/$defs/SyntheticDigestV1"
    },
    "canonical_binding_truth_digest": {
      "$ref": "#/$defs/SyntheticDigestV1"
    },
    "cells": {
      "items": {
        "$ref": "#/$defs/CompiledEnterpriseAccessCellV1"
      },
      "title": "Cells",
      "type": "array"
    },
    "compiler_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Compiler Version",
      "type": "string"
    },
    "composition_digest": {
      "$ref": "#/$defs/SyntheticDigestV1"
    },
    "directory_rbac_truth_digest": {
      "$ref": "#/$defs/SyntheticDigestV1"
    },
    "evaluation_corpus_digest": {
      "$ref": "#/$defs/SyntheticDigestV1"
    },
    "identity_access_universe_digest": {
      "$ref": "#/$defs/SyntheticDigestV1"
    },
    "policy_conflicts": {
      "items": {
        "$ref": "#/$defs/PolicyConflictTruthV1"
      },
      "title": "Policy Conflicts",
      "type": "array"
    },
    "rebac_truth_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/SyntheticDigestV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "identity_access_universe_digest",
    "canonical_binding_truth_digest",
    "evaluation_corpus_digest",
    "composition_digest",
    "authorization_kernel_digest",
    "directory_rbac_truth_digest",
    "abac_truth_digest",
    "rebac_truth_digest",
    "policy_conflicts",
    "cells"
  ],
  "title": "CompiledEnterpriseAccessStateV1",
  "type": "object"
}
