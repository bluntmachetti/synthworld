    "AbacCellPredictionV1": {
      "additionalProperties": false,
      "properties": {
        "actual_outcome": {
          "$ref": "#/$defs/MechanismOutcome"
        },
        "cell_id": {
          "title": "Cell Id",
          "type": "string"
        },
        "intended_outcome": {
          "$ref": "#/$defs/MechanismOutcome"
        }
