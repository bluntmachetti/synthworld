        "not_applicable",
        "active",
        "inactive",
        "not_yet_valid",
        "expired"
      ],
      "title": "LifecycleStatus",
      "type": "string"
    },
    "MechanismOutcome": {
      "description": "Native outcome retained before benchmark default-deny normalization.",
      "enum": [
        "allow",
        "deny",
        "not_applicable",
        "unknown"
      ],
      "title": "MechanismOutcome",
      "type": "string"
    },
    "PredicateOutcome": {
      "enum": [
        "true",
        "false",
        "unknown"
      ],
      "title": "PredicateOutcome",
      "type": "string"
