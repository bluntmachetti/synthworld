{
  "$defs": {
    "AdversarialAuthorizationMechanism": {
      "enum": [
        "tenant",
        "scope",
        "binding",
        "time",
        "clearance",
        "composition"
      ],
      "title": "AdversarialAuthorizationMechanism",
      "type": "string"
    },
    "AdversarialCohortSummaryV1": {
      "additionalProperties": false,
      "properties": {
        "discriminating_denominator": {
          "minimum": 0,
          "title": "Discriminating Denominator",
          "type": "integer"
        },
        "mechanism": {
          "$ref": "#/$defs/AdversarialAuthorizationMechanism"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "total_scenarios": {
          "minimum": 0,
          "title": "Total Scenarios",
          "type": "integer"
        }
      },
      "required": [
        "mechanism",
        "total_scenarios",
        "discriminating_denominator"
      ],
      "title": "AdversarialCohortSummaryV1",
      "type": "object"
    },
    "EnterpriseAuthorizationMetricV1": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "denominator_meaning": {
          "minLength": 1,
          "title": "Denominator Meaning",
          "type": "string"
        },
        "empty_behaviour": {
          "$ref": "#/$defs/MetricEmptyBehaviour"
        },
        "family": {
          "minLength": 1,
          "title": "Family",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "support": {
          "minimum": 0,
          "title": "Support",
          "type": "integer"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "family",
        "name",
        "numerator",
        "denominator",
        "support",
        "denominator_meaning",
        "empty_behaviour",
        "value"
      ],
      "title": "EnterpriseAuthorizationMetricV1",
      "type": "object"
    },
    "MetricEmptyBehaviour": {
      "enum": [
        "nonempty",
        "null_if_empty"
      ],
      "title": "MetricEmptyBehaviour",
      "type": "string"
    },
    "SyntheticDigestV1": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "SyntheticDigestV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Independent metrics plus explicit total and discriminating cohorts.",
  "properties": {
    "cohorts": {
      "items": {
        "$ref": "#/$defs/AdversarialCohortSummaryV1"
      },
      "title": "Cohorts",
      "type": "array"
    },
    "evaluator_digest": {
      "$ref": "#/$defs/SyntheticDigestV1"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/EnterpriseAuthorizationMetricV1"
      },
      "title": "Metrics",
      "type": "array"
    },
    "prediction_digest": {
      "$ref": "#/$defs/SyntheticDigestV1"
    },
    "profile_version": {
      "const": "enterprise-authorization-adversarial-1.0.0",
      "default": "enterprise-authorization-adversarial-1.0.0",
      "title": "Profile Version",
      "type": "string"
    },
    "public_digest": {
      "$ref": "#/$defs/SyntheticDigestV1"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "public_digest",
    "evaluator_digest",
    "prediction_digest",
    "cohorts",
    "metrics"
  ],
  "title": "EnterpriseAdversarialAuthorizationMetricsV1",
  "type": "object"
}
