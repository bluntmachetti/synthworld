{
  "$defs": {
    "AgenticFailureReason": {
      "enum": [
        "enterprise_denied",
        "subject_mismatch",
        "tenant_mismatch",
        "agent_account_inactive",
        "agent_account_binding_mismatch",
        "wrong_runtime",
        "credential_invalid",
        "capability_exceeded",
        "no_active_delegation",
        "delegation_mismatch"
      ],
      "title": "AgenticFailureReason",
      "type": "string"
    },
    "AgenticGateOutcome": {
      "enum": [
        "satisfied",
        "unsatisfied",
        "not_applicable"
      ],
      "title": "AgenticGateOutcome",
      "type": "string"
    },
    "AgenticGatePredictionV1": {
      "additionalProperties": false,
      "properties": {
        "agent_account_gate": {
          "$ref": "#/$defs/AgenticGateOutcome"
        },
        "capability_gate": {
          "$ref": "#/$defs/AgenticGateOutcome"
        },
        "credential_gate": {
          "$ref": "#/$defs/AgenticGateOutcome"
        },
        "delegation_gate": {
          "$ref": "#/$defs/AgenticGateOutcome"
        },
        "runtime_gate": {
          "$ref": "#/$defs/AgenticGateOutcome"
        },
        "subject_gate": {
          "$ref": "#/$defs/AgenticGateOutcome"
        },
        "tenant_gate": {
          "$ref": "#/$defs/AgenticGateOutcome"
        }
      },
      "required": [
        "subject_gate",
        "tenant_gate",
        "agent_account_gate",
        "runtime_gate",
        "credential_gate",
        "capability_gate",
        "delegation_gate"
      ],
      "title": "AgenticGatePredictionV1",
      "type": "object"
    },
    "AuthorizationDecision": {
      "enum": [
        "allow",
        "deny"
      ],
      "title": "AuthorizationDecision",
      "type": "string"
    },
    "EnterpriseAgenticTraceRowV1": {
      "additionalProperties": false,
      "properties": {
        "agent_account_id": {
          "minLength": 1,
          "title": "Agent Account Id",
          "type": "string"
        },
        "agent_principal_id": {
          "minLength": 1,
          "title": "Agent Principal Id",
          "type": "string"
        },
        "benchmark_digest": {
          "$ref": "#/$defs/SyntheticDigestV1"
        },
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "enterprise_decision": {
          "$ref": "#/$defs/AuthorizationDecision"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "failure_reasons": {
          "items": {
            "$ref": "#/$defs/AgenticFailureReason"
          },
          "title": "Failure Reasons",
          "type": "array"
        },
        "final_decision": {
          "$ref": "#/$defs/AuthorizationDecision"
        },
        "gates": {
          "$ref": "#/$defs/AgenticGatePredictionV1"
        },
        "human_principal_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Human Principal Id"
        },
        "reconstructable_at_audit": {
          "title": "Reconstructable At Audit",
          "type": "boolean"
        },
        "runtime_id": {
          "minLength": 1,
          "title": "Runtime Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "benchmark_digest",
        "case_id",
        "enterprise_decision",
        "gates",
        "final_decision",
        "failure_reasons",
        "agent_principal_id",
        "agent_account_id",
        "runtime_id",
        "evidence_refs",
        "reconstructable_at_audit"
      ],
      "title": "EnterpriseAgenticTraceRowV1",
      "type": "object"
    },
    "SyntheticDigestV1": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "SyntheticDigestV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "benchmark_digest": {
      "$ref": "#/$defs/SyntheticDigestV1"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/EnterpriseAgenticTraceRowV1"
      },
      "minItems": 1,
      "title": "Rows",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "benchmark_digest",
    "rows"
  ],
  "title": "EnterpriseAgenticPredictionV1",
  "type": "object"
}
