        {
          "$ref": "#/$defs/AuthorizationDecision"
        },
        {
          "type": "null"
        }
      ]
    },
    "raw_boolean_decision": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
