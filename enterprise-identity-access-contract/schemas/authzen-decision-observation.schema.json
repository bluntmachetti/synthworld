      "$ref": "#/$defs/AuthZenRawOutcome"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "transport_evidence_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/SyntheticDigestV1"
