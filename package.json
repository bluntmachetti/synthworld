{
  "name": "synthworld-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Hermetic documentation build for SynthWorld.",
  "engines": {
    "node": "22.12.0",
    "npm": "10.9.0"
  },
  "packageManager": "npm@10.9.0",
  "scripts": {
    "docs:prepare": "node tools/prepare_docs_content.mjs && node tools/generate_registry_catalogue.mjs",
    "docs:build": "npm run docs:prepare && blume build",
    "docs:check": "npm run docs:prepare && blume check --strict && blume validate && blume build && blume audit --verbose && node tools/audit_docs_dist.mjs",
    "docs:preview": "npm run docs:prepare && blume preview"
  },
  "dependencies": {
    "blume": "1.4.0"
  }
}
