{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "byte_size": {"minimum": 0, "type": "integer"},
          "format": {"enum": ["json", "jsonl", "sha256sum"]},
          "integrity_record_ids": {"items": {"type": "string"}, "type": "array"},
          "package_path": {"pattern": "^synthworld/benchmarks/", "type": "string"},
          "path": {"pattern": "^src/synthworld/benchmarks/", "type": "string"},
          "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
        },
        "required": ["byte_size", "format", "integrity_record_ids", "package_path", "path", "sha256"],
        "type": "object"
      },
      "type": "array"
    },
    "integrity_records": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "members": {"items": {"type": "string"}, "type": "array"},
          "path": {"type": "string"},
          "scheme": {"enum": ["sha256sum", "sha256-artifact-set-v1", "sha256-size-manifest-v1"]}
        },
        "required": ["id", "members", "path", "scheme"],
        "type": "object"
      },
      "type": "array"
    },
    "inventory_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "schema_version": {"const": "1.0.0"}
  },
  "required": ["schema_version", "inventory_digest", "artifacts", "integrity_records"],
  "type": "object"
}
