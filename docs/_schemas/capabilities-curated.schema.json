{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {"items": {"$ref": "#/$defs/capability"}, "type": "array"},
    "schema_version": {"const": "1.0.0"}
  },
  "required": ["capabilities", "schema_version"],
  "type": "object",
  "$defs": {
    "capability": {
      "additionalProperties": false,
      "properties": {
        "id": {"minLength": 1, "type": "string"},
        "interfaces": {"$ref": "#/$defs/interfaces"},
        "journey_route": {"minLength": 1, "type": "string"},
        "maturity": {"enum": ["experimental", "preview", "stable", "planned"]},
        "notes": {"type": "string"},
        "related_surface_ids": {"items": {"type": "string"}, "type": "array"},
        "roadmap_routes": {"items": {"type": "string"}, "type": "array"},
        "since": {"minLength": 1, "type": "string"},
        "summary": {"minLength": 1, "type": "string"},
        "support": {"minLength": 1, "type": "string"},
        "title": {"minLength": 1, "type": "string"}
      },
      "required": ["id", "interfaces", "journey_route", "maturity", "notes", "related_surface_ids", "roadmap_routes", "since", "summary", "support", "title"],
      "type": "object"
    },
    "interface": {
      "additionalProperties": false,
      "properties": {
        "coverage": {"enum": ["none", "partial", "full"]},
        "subset_note": {"type": ["string", "null"]},
        "surface_ids": {"items": {"type": "string"}, "type": "array"}
      },
      "required": ["coverage", "subset_note", "surface_ids"],
      "type": "object"
    },
    "interfaces": {
      "additionalProperties": false,
      "properties": {
        "cli": {"$ref": "#/$defs/interface"},
        "python": {"$ref": "#/$defs/interface"}
      },
      "required": ["cli", "python"],
      "type": "object"
    }
  }
}
